detailed-type-extension-file = { $ext } 文件
detailed-type-extension-category = { $ext } { $category }
detailed-type-source-code = { $language } 源代码

# 常见 MIME 类型在系统 shared-mime-info 缺译时的简体中文补充。
mime-fallback-text-plain = 纯文本文档
mime-fallback-application-octet-stream = 二进制文件
mime-fallback-application-epub-zip = EPUB 电子书
mime-fallback-application-x-executable = 可执行文件
mime-fallback-application-x-sharedlib = 共享库
mime-fallback-application-x-shellscript = Shell 脚本
mime-fallback-application-x-desktop = 桌面入口
mime-fallback-application-wasm = WebAssembly 模块
mime-fallback-application-vnd-efi-iso = 光盘映像
mime-fallback-application-vnd-microsoft-portable-executable = Windows 可执行程序
mime-fallback-application-x-dosexec = DOS 可执行程序
mime-fallback-application-x-bzip2 = Bzip2 归档文件
mime-fallback-application-x-bzip2-compressed-tar = Tar 归档文件（bzip2 压缩）
mime-fallback-application-x-powershell = PowerShell 脚本
mime-fallback-application-schema-json = JSON Schema
mime-fallback-application-json5 = JSON5 文档
mime-fallback-application-x-zerosize = 空文件
mime-fallback-image-svg-xml-compressed = 压缩 SVG 图像
mime-fallback-application-vnd-comicbook-zip = 漫画书归档（ZIP）
mime-fallback-application-vnd-comicbook-rar = 漫画书归档（RAR）
