pkgname = gds-files
	pkgdesc = Native GPUI file manager with embedded terminals
	depends = libgcc
	depends = glibc
	depends = wayland
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = fontconfig
	depends = freetype2
	depends = libxcb
	depends = libglvnd
	depends = vulkan-icd-loader
	depends = xdg-desktop-portal
	depends = shared-mime-info
	depends = hicolor-icon-theme
	optdepends = ffmpeg: video thumbnails
	optdepends = udisks2: removable drive management
	optdepends = xdg-terminal-exec: open folders in external terminal
	optdepends = xdg-utils: open external web links
	optdepends = xdg-desktop-portal-gds: use Files as the system file picker
