FROM archlinux:base-devel
RUN pacman -Syu --noconfirm --needed rust clang lld git python \
        wayland libxkbcommon libxkbcommon-x11 fontconfig freetype2 \
        libxcb libglvnd vulkan-icd-loader xdg-desktop-portal \
        shared-mime-info hicolor-icon-theme desktop-file-utils namcap \
    && pacman -Scc --noconfirm
ARG BUILD_UID=1000
RUN getent passwd ${BUILD_UID} || useradd -M -u ${BUILD_UID} -g 0 builder
WORKDIR /cache/package
