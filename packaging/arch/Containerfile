FROM archlinux:base-devel
RUN pacman -Syu --noconfirm --needed rust clang lld cmake git python \
        openssl wayland libxkbcommon libxkbcommon-x11 fontconfig freetype2 \
        libx11 libxcb alsa-lib dbus zstd zlib libglvnd vulkan-icd-loader \
        xdg-utils xdg-terminal-exec xdg-desktop-portal udisks2 python-gobject gtk3 desktop-file-utils namcap \
    && pacman -Scc --noconfirm
ARG BUILD_UID=1000
RUN getent passwd ${BUILD_UID} || useradd -M -u ${BUILD_UID} -g 0 builder
WORKDIR /cache/package
