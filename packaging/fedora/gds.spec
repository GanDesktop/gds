# The host-side build script supplies the source, cache and package metadata.
%global debug_package %{nil}
%if "%{gds_profile}" == "dev"
%global _binary_payload w3.zstdio
%endif

Name:           gds-files
Version:        %{gds_version}
Release:        %{gds_release}%{?dist}
Summary:        Native file manager for Linux desktops
License:        Apache-2.0
URL:            https://github.com/GanDesktop/gds

# ELF dependencies are generated by RPM. These also cover dlopen and helpers.
Requires:       libwayland-client
Requires:       libxkbcommon
Requires:       fontconfig
Requires:       mesa-libEGL
Requires:       vulkan-loader
Requires:       xdg-utils
Requires:       xdg-terminal-exec
Requires:       xdg-desktop-portal
Requires:       udisks2
Recommends:     ffmpeg-free
Recommends:     mesa-vulkan-drivers

%description
GDS Files browses local folders, mounted volumes and SFTP/SMB locations,
with file operations, previews and embedded terminals.

%package -n xdg-desktop-portal-gds
Summary:        GDS desktop portal backend
Requires:       xdg-desktop-portal
%{?systemd_requires}

%description -n xdg-desktop-portal-gds
GDS Portal provides the desktop FileChooser interface. Install GDS Files
separately to use its native file picker. Portal routing is configured by
the user and is not changed by installing this package.

%build
cd %{gds_source}
export GDS_BUILD_TAG=%{gds_build_tag}
# Fedora's RPM flags otherwise force release optimization on dev builds too.
if [ "%{gds_profile}" = dev ]; then
    unset RUSTFLAGS
fi
cargo build --locked --profile %{gds_profile} \
    --bin gds-files --features files
cargo build --locked --profile %{gds_profile} \
    --bin xdg-desktop-portal-gds --features portal

%install
python3 %{gds_source}/packaging/fedora/install.py \
    %{buildroot} %{gds_target}/%{gds_binary_profile}

%check
desktop-file-validate %{buildroot}%{_datadir}/applications/io.github.GanDesktop.GdsFiles.desktop
%{buildroot}%{_bindir}/gds-files --help
%{buildroot}%{_libexecdir}/xdg-desktop-portal-gds --help

%post -n xdg-desktop-portal-gds
%systemd_user_post xdg-desktop-portal-gds.service

%preun -n xdg-desktop-portal-gds
%systemd_user_preun xdg-desktop-portal-gds.service

%postun -n xdg-desktop-portal-gds
%systemd_user_postun_with_restart xdg-desktop-portal-gds.service

%files
%license %{_datadir}/licenses/gds-files/LICENSE
%{_bindir}/gds-files
%{_datadir}/applications/io.github.GanDesktop.GdsFiles.desktop
%{_datadir}/icons/hicolor/scalable/apps/io.github.GanDesktop.GdsFiles.svg

%files -n xdg-desktop-portal-gds
%license %{_datadir}/licenses/xdg-desktop-portal-gds/LICENSE
%{_libexecdir}/xdg-desktop-portal-gds
%{_datadir}/dbus-1/services/org.freedesktop.impl.portal.desktop.gds.service
%{_datadir}/xdg-desktop-portal/portals/gds.portal
%{_userunitdir}/xdg-desktop-portal-gds.service
